# Unity MCP Relay Agent — Environment Variables

# ── Backend connection ─────────────────────────────────────────────────────
# URL of the FastAPI backend.
# Local dev:   http://localhost:8000
# Production:  https://your-server.com
BACKEND_URL=http://localhost:8000

# Shared secret — must match UNITY_AGENT_TOKEN on the backend (.env)
UNITY_AGENT_TOKEN=dev-token

# ── Unity MCP Server ──────────────────────────────────────────────────────
# Host and port where CoplayDev/unity-mcp listens inside Unity Editor.
# Default: localhost:6400 — do not change unless you modified the package settings.
UNITY_MCP_HOST=localhost
UNITY_MCP_PORT=6400

# ── Polling ───────────────────────────────────────────────────────────────
# How often (seconds) to poll the backend for new spawn events.
POLL_INTERVAL_SEC=1.0
