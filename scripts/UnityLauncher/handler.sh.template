#!/bin/bash
# Writes a spawn request JSON and launches Unity Editor if it is not running.
# REPO_ROOT is substituted by register-launcher at install time.
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

REPO="__REPO_ROOT__"
URL="${1:-}"

if [ -z "$URL" ]; then
  echo "usage: handler.sh unity3dgen://..." >&2
  exit 2
fi

# Resolve python3 from safe explicit paths, excluding Xcode's binary.
PYTHON3=""
for _p in \
    /opt/homebrew/bin/python3 \
    /opt/homebrew/opt/python@3.13/bin/python3 \
    /opt/homebrew/opt/python@3.12/bin/python3 \
    /opt/homebrew/opt/python@3.11/bin/python3 \
    /usr/local/bin/python3 \
    /usr/bin/python3; do
  if [ -x "$_p" ] && [[ "$_p" != /Applications/Xcode* ]]; then
    PYTHON3="$_p"
    break
  fi
done

if [ -z "$PYTHON3" ]; then
  osascript -e 'display dialog "Unity Launcher: python3 not found. Install Python 3 via Homebrew (brew install python3)." buttons {"OK"} default button 1'
  exit 1
fi

REQDIR="$REPO/UnityProject/Assets/SpawnRequests"
mkdir -p "$REQDIR"

STAMP="$("$PYTHON3" -c 'import time;print(f"{int(time.time()*1000000)}")')"
OUT="$REQDIR/spawn_${STAMP}.json"

# Parse the unity3dgen:// URL inline via -c so python3 never needs to open a
# file on the Desktop (macOS TCC blocks .app-bundled python3 from doing that).
"$PYTHON3" -c '
import sys, json, time
from urllib.parse import parse_qs, unquote, urlparse
uri = sys.argv[1]
p = urlparse(uri)
q = {k: v[0] for k, v in parse_qs(p.query).items()}
url = unquote(q.get("url", ""))
if not url:
    sys.exit("unity3dgen: missing url parameter")
scene = q.get("scene", "existing").lower()
if scene not in ("new", "existing"):
    scene = "existing"
req = {
    "id": q.get("id") or "model_" + str(int(time.time() * 1000)),
    "url": url,
    "scene": scene,
    "name": unquote(q.get("name", "")),
}
print(json.dumps(req))
' "$URL" > "$OUT.tmp"
mv "$OUT.tmp" "$OUT"

# Launch Unity Editor on the project if not already running.
if ! pgrep -xq Unity; then
  open -a Unity --args -projectPath "$REPO/UnityProject" >/dev/null 2>&1 || \
    osascript -e 'display dialog "Could not launch Unity Editor. Install Unity Hub and make sure Unity 2022.3 LTS is available." buttons {"OK"} default button 1'
fi
